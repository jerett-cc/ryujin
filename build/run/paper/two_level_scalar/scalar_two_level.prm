subsection App
  set print_solution_bool = true
  set Time Bricks = 10
  set min_num_coarsest_points = 1
  set print factor = 1 # how many cpoints do we skip during output?
  set Start Time = 0.0
  set Stop Time = 0.9
  set cfactor = 2 ## 2 is default
  set max_iter = 10
  set use_fmg = false ## use f multigrid cycle
  set n relax = 1
  ## if this dips, then we will not have the projection operation, which is key for stability
  set access_level = 3 
  set base name = two_level_scalar_i_type
  #set storage name = /raid/cherry/ryujin/initial_coarse/
  #set calculate conserved quantities = false
  set reference density = 1.4
  set reference internal energy = 2.5
  set reference scaling = 1e-2
  set set initial guess from exact = true
  set skip first down cycle = true
  #set max levels = 3
  set mgrit print level = 3
  set mgrit abs tolerance = 0.0
  set use reference for projection = true
end
subsection C - Discretization
  set geometry            = rectangular domain
  subsection rectangular domain
    set boundary condition left  = dirichlet
    set boundary condition right = dirichlet
    set grading pull back        = x
    set grading push forward     = x
    set position bottom left     = 0
    set position top right       = 1
    set subdivisions x           = 5000
  end
end
subsection E - InitialValues
  set configuration = function
  set direction     = 1
  set perturbation  = 0
  set position      = 0
  subsection function
    set expression = if(x > 1e-12, 0, 1)
  end
end

